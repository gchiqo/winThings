<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX Package Manifest for "Read Selected"
  Developer: Giorgi Chikovani

  BEFORE BUILDING:
  1. Identity Name, Publisher and PublisherDisplayName match Partner Center >
     Read Selected > Product management > Product identity (Store ID 9NVSF1K5TRHP).
     Don't change them.
  2. Bump Version for every Store submission (the last two numbers can stay 0).
  3. Run store\make_assets.py to generate Assets\ before packaging.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap rescap desktop">

  <Identity
    Name="GiorgiChikovani.ReadSelected"
    Publisher="CN=4EE59C24-1EF0-43DA-A94B-3A0B79822BD3"
    Version="1.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Read Selected</DisplayName>
    <PublisherDisplayName>Giorgi Chikovani</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Windows 10 1809 (RS5) minimum; tested up to Windows 11 22H2 -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="reader.exe"
      EntryPoint="Windows.FullTrustApplication">

      <uap:VisualElements
        DisplayName="Read Selected"
        Description="Select any text anywhere and press Ctrl+Shift+A to hear it read aloud using neural TTS voices."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Read Selected" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!--
          StartupTask: lets Windows manage start-at-login without the app
          writing registry keys. Declared disabled; the Settings window enables
          it at the user's request via Windows.ApplicationModel.StartupTask.
        -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="reader.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="WinThingsReaderStartup"
            Enabled="false"
            DisplayName="Read Selected" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      runFullTrust: required for Desktop Bridge apps that use RegisterHotKey,
      UI Automation, clipboard access, and subprocess (piper.exe).
    -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
